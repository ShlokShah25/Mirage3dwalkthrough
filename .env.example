# Copy these into Vercel → Project → Settings → Environment Variables (Production).
# For local testing, copy this file to .env.local and fill it in.

# Claude (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=sk-ant-...
# Only if your key is not tied to a workspace (console → Workspaces → the workspace's ID)
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Optional model overrides
# MODEL_COMPLEX=claude-opus-5-5
# MODEL_DEFAULT=claude-sonnet-5
# MODEL_DESIGN=claude-opus-5-5     # furniture placement (defaults to MODEL_COMPLEX)
# Deep plan read: how many checking passes a plan may take (each is one MODEL_COMPLEX call with up to ten images).
# 5 by default; 0 turns it off and uses one quick second look instead.
# PLAN_DEEP_ROUNDS=5

# fal.ai: photo-real renders ("Make it real"). fal.ai → Dashboard → Keys. Leave empty to hide the feature.
FAL_KEY=
# Optional: a different fal image model (default fal-ai/flux-pro/kontext)
# FAL_MODEL=fal-ai/flux-pro/kontext
# Optional: Mira's spoken voice (ElevenLabs voice name on fal, default Charlotte)
# MIRA_VOICE=Charlotte

# Supabase (Project settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...      # secret: server only

# Razorpay (Dashboard → Account & Settings → API keys; use test keys first)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...                # secret: server only
RAZORPAY_WEBHOOK_SECRET=...            # the secret you type when creating the webhook
RAZORPAY_PLAN_PRO=plan_...             # ₹6,999 monthly plan id
RAZORPAY_PLAN_MAX=plan_...             # ₹14,999 monthly plan id
# Optional: ₹3,999-off-first-month offer for Home Pass buyers who upgrade within 7 days
# RAZORPAY_OFFER_UPGRADE=offer_...

# NEVER set MIRAGE_DB=memory in production. It turns on test sign-in and an in-memory database.

# Launch offer on the Home Pass (first 5 homes ₹1,999, next 45 ₹2,499). Set to off to end it early.
# LAUNCH_OFFER=off
